{
  "name": "@exer7um/eslint-config",
  "version": "2.4.0",
  "description": "Конфигурация ESLint",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "license": "MIT",
  "author": {
    "name": "Vasily Kuzin",
    "email": "work@exer7um.com",
    "url": "https://github.com/ExEr7um/prettier-config"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExEr7um/eslint-config.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "eslint": "eslint --max-warnings=0",
    "eslint:fix": "eslint --max-warnings=0 --fix",
    "prepare": "vp config",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.5.1",
    "@eslint-react/eslint-plugin": "^5.12.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@vitest/eslint-plugin": "^1.6.21",
    "defu": "^6.1.7",
    "eslint": "^10.6.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.1.2",
    "eslint-plugin-jsdoc": "^63.0.12",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "eslint-plugin-yml": "^3.6.0"
  },
  "devDependencies": {
    "@exer7um/vp-config": "0.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3"
  }
}
